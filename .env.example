# Copy this file to .env and fill in real values. .env is gitignored -
# .env.example is the only one of the two that should ever be committed.

# --- Cloud runtime (Supabase) ----------------------------------------------
# Project Settings -> API in the Supabase dashboard.
STORAGE_BACKEND=supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional: only used by `scripts.cloud_check` to prove Row Level Security is
# actually blocking anonymous reads. Safe to include even in a public repo -
# the anon key is meant to be public; it's the service-role key above that
# must stay secret.
# SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# --- Optional real model (instead of the scripted providers) ---------------
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# GEMINI_MODEL=gemini-2.5-flash

# --- Local no-key assessment path -------------------------------------------
# Leave STORAGE_BACKEND unset (or set to sqlite) and these are used instead;
# scripts/demo.py overrides them with a fresh temp directory on every run.
# LEAVE_DB=leave.db
# AGENT_DB=agent.db
